{
  "name": "pros-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@pros/web",
    "dev:mobile": "turbo dev --filter=@pros/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "overrides": {
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18"
  },
  "devDependencies": {
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "turbo": "^2.3.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.2.4"
}

